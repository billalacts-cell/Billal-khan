rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function isValidForm(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.url is string && data.url.size() >= 10 && data.url.size() <= 500 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
             data.ownerId is string && data.ownerId == request.auth.uid &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             (!('color' in data) || (data.color is string && data.color.size() <= 30)) &&
             (!('openCount' in data) || (data.openCount is number && data.openCount >= 0)) &&
             (!('isStarred' in data) || (data.isStarred is bool));
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /forms/{formId} {
      allow get: if isSignedIn() && existing().ownerId == request.auth.uid && isValidId(formId);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isSignedIn() &&
                    isValidId(formId) &&
                    isValidForm(incoming()) &&
                    incoming().keys().hasAll(['id', 'title', 'url', 'category', 'ownerId']) &&
                    incoming().keys().hasOnly(['id', 'title', 'url', 'category', 'description', 'color', 'ownerId', 'createdAt', 'updatedAt', 'lastOpenedAt', 'openCount', 'isStarred']);

      allow update: if isSignedIn() &&
                    isValidId(formId) &&
                    existing().ownerId == request.auth.uid &&
                    incoming().ownerId == existing().ownerId &&
                    isValidForm(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['title', 'url', 'category', 'description', 'color', 'updatedAt', 'lastOpenedAt', 'openCount', 'isStarred']);

      allow delete: if isSignedIn() &&
                    isValidId(formId) &&
                    existing().ownerId == request.auth.uid;
    }

    match /equipment/{equipmentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(equipmentId);
    }

    match /calibration_batches/{batchId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(batchId);
    }

    match /calibration_email_logs/{logId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(logId);
    }

    match /calibration_recipients/{recId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(recId);
    }
  }
}
